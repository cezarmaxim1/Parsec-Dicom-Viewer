<Window x:Class="OpenRadViewer.Views.FazekasClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fazekas Scale (White Matter Hyperintensities)"
        Height="740" Width="1060"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GradeCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Image & Classification -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E65100" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="AXIAL FLAIR / T2 MRI" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock Text="Fazekas Scale (White Matter Hyperintensities)" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Text="Rating scale for cerebral white matter lesions &amp; microangiopathy / cerebral small vessel disease (Fazekas et al.)"
                               FontSize="11" Foreground="#999999" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close" Style="{StaticResource ActionButton}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Split: Left Image, Right Classification Table) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Reference Diagram Image -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid Margin="6">
                    <Image x:Name="FazekasImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#262626" />

            <!-- RIGHT: Classification Criteria & Diagnostic Cutoffs -->
            <Border Grid.Column="2" Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WHITE MATTER HYPERINTENSITY (WMH) CRITERIA" FontWeight="Bold" FontSize="11" Foreground="#888888" Margin="0,0,0,10" />

                        <!-- Score 0: Fazekas 0 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#00897B">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#00897B" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Fazekas 0" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Normal / Absent" FontWeight="SemiBold" Foreground="#4DB6AC" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Physiological" FontSize="10" FontWeight="SemiBold" Foreground="#80CBC4" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Deep White Matter (DWM): None or a single punctate WMH lesion&#x0a;• Periventricular (PVWM): Absent / normal ependyma"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 1: Fazekas 1 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#0288D1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0288D1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Fazekas 1" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Mild Lesions" FontWeight="SemiBold" Foreground="#29B6F6" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Aging Norm" FontSize="10" FontWeight="SemiBold" Foreground="#81D4FA" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Deep White Matter (DWM): Multiple punctate lesions&#x0a;• Periventricular (PVWM): &quot;Caps&quot; or pencil-thin lining around ventricles&#x0a;• Clinical: Common &amp; considered normal in physiological elderly brain"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 2: Fazekas 2 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#FBC02D">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FBC02D" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Fazekas 2" FontWeight="Bold" FontSize="11" Foreground="#212121" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Moderate / Confluent Bridging" FontWeight="SemiBold" Foreground="#FFEE58" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Pathological" FontSize="10" FontWeight="SemiBold" Foreground="#FFF59D" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Deep White Matter (DWM): Beginning confluency of lesions (bridging)&#x0a;• Periventricular (PVWM): Smooth &quot;halo&quot; around lateral ventricles&#x0a;• Clinical: Microangiopathy / early cerebral small vessel disease"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 3: Fazekas 3 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#D32F2F">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#D32F2F" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Fazekas 3" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Severe / Extensive Confluence" FontWeight="SemiBold" Foreground="#EF5350" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="High Risk" FontSize="10" FontWeight="SemiBold" Foreground="#EF9A9A" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Deep White Matter (DWM): Large confluent lesions (diffuse involvement)&#x0a;• Periventricular (PVWM): Irregular margins extending deep into white matter&#x0a;• Clinical: Severe vascular leukoaraiosis, increased risk of vascular dementia &amp; stroke"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- CLINICAL INTERPRETATION GUIDE -->
                        <Border Background="#2B1D12" BorderBrush="#FF6D00" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="🧠 CLINICAL INTERPRETATION &amp; GRADING KEY" FontWeight="Bold" FontSize="10" Foreground="#FFAB40" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" Foreground="#FFE0B2" LineHeight="17">
                                    <Run FontWeight="SemiBold" Foreground="#FFFFFF">• Fazekas 0 &amp; 1:</Run> Normal aging phenomenon (non-specific, low vascular risk).&#x0a;
                                    <Run FontWeight="SemiBold" Foreground="#FFFFFF">• Fazekas 2 &amp; 3:</Run> Pathological markers of <Run FontWeight="Bold" Foreground="#FF8A80">Cerebral Small Vessel Disease (CSVD)</Run> and vascular cognitive impairment.&#x0a;
                                    <Run FontWeight="SemiBold" Foreground="#FFFFFF">• Typical MRI Sequence:</Run> Axial FLAIR (best sensitivity) and T2 Turbo Spin Echo.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
