<Window x:Class="OpenRadViewer.Views.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OpenRadViewer.Views"
        mc:Ignorable="d"
        Title="Local Database - Parsec DICOM Archive" 
        Height="680" Width="1280"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#222222" />
        <SolidColorBrush x:Key="AccentGold" Color="#F5AF28" />

        <!-- Force dark highlight colors when rows are selected or inactive -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B2C0D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3B2C0D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />

        <!-- Modern Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#252525" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowBackground" Value="#181818" />
            <Setter Property="AlternatingRowBackground" Value="#1E1E1E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B2C0D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#3B2C0D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </MultiTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Status / Search Subbar -->
            <RowDefinition Height="*" MinHeight="150" />    <!-- Studies List -->
            <RowDefinition Height="5" />    <!-- Splitter -->
            <RowDefinition Height="180" MinHeight="100" />  <!-- Series List -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP TOOLBAR, also acts as the title bar -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#191919">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Parsec;component/app_icon.png" Width="22" Height="22" Margin="12,12,10,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Text="Local Database" Foreground="#E0E0E0" FontSize="13" Margin="0,14,14,0" VerticalAlignment="Top" />

                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Open and import -->
                    <Border Style="{StaticResource ToolbarCapsule}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButton}" Click="OnOpenInViewer" ToolTip="Open selected study in Viewer (Enter / Double-Click)">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconDesktop}" /><TextBlock Text="Open in Viewer" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OnImportFolder" ToolTip="Import external DICOM folder to Database">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconFolderPlus}" /><TextBlock Text="Import Folder" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="OnImportActiveStudy" ToolTip="Save current open study into Database archive">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconDatabaseImport}" /><TextBlock Text="Import Current Study" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="BtnSendToPacs" Style="{StaticResource ToolbarButton}" Click="OnSendToPacsClick" ToolTip="Send selected study or multiple studies to a PACS server (C-STORE)">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconUpload}" /><TextBlock Text="Send to PACS" Margin="6,0,0,0" VerticalAlignment="Center" /><Path Style="{StaticResource ToolChevron}" Margin="5,0,0,0" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Study status and removal -->
                    <Border Style="{StaticResource ToolbarCapsule}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButton}" Click="OnToggleReviewed" ToolTip="Toggle Reviewed / Done status (Space)">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconCheck}" /><TextBlock Text="Reviewed" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Foreground="#EF9A9A" Click="OnDeleteStudy" ToolTip="Delete selected study from Database (Del)">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconTrash}" /><TextBlock Text="Delete" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Foreground="#EF5350" Click="OnClearAllDatabase" ToolTip="Clear entire local Database (Delete all studies and files)">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolIcon}" Data="{StaticResource IconTrash}" /><TextBlock Text="Clear Database" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <views:WindowControlsBar Grid.Column="3" />
            </Grid>
        </Border>


        <!-- 2. STATUS / SEARCH SUB-BAR -->
        <Border Grid.Row="1" Background="#191919" BorderThickness="0" Padding="12,2,12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Database Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="#F5AF28" Data="M8,1 A7,7 0 1,0 15,8 L8,8 Z" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock x:Name="TxtDbSummary" Text="Loading studies..." FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Search Box -->
                <Border Grid.Column="1" Background="#262626" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="7" Width="260" Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource ToolIcon}" Stroke="#888888" Data="{StaticResource IconSearch}" Margin="0,0,5,0" />
                        <TextBox Grid.Column="1" x:Name="TxtSearch" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0"
                                 FontSize="11.5" VerticalAlignment="Center" TextChanged="OnSearchTextChanged" />
                        <TextBlock Grid.Column="1" Text="Search all studies..." Foreground="#666666" FontSize="11.5" 
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}" />
                        <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Height="18" Padding="3,0" Click="OnClearSearch"
                                Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Path Stroke="#888888" StrokeThickness="1.4" Data="M2,2 L8,8 M8,2 L2,8" Width="9" Height="9" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. TOP GRID: STUDIES -->
        <DataGrid Grid.Row="2" x:Name="GridStudies" SelectionMode="Extended" SelectionUnit="FullRow"
                  SelectionChanged="OnStudySelectionChanged"
                  MouseDoubleClick="OnStudyDoubleClick" PreviewKeyDown="OnGridStudiesKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in Viewer (Enter)" Click="OnOpenInViewer" FontWeight="Bold" />
                    <MenuItem Header="Add to current study" Click="OnAddStudyToCurrentStudy" />
                    <MenuItem Header="Send to PACS..." Click="OnSendToPacsClick" FontWeight="SemiBold" Foreground="#F5AF28" />
                    <MenuItem Header="Reviewed (Space)" Click="OnToggleReviewed" />
                    <MenuItem Header="Edit Notes..." Click="OnEditNotes" Foreground="#F5AF28" />
                    <Separator />
                    <MenuItem Header="Delete from Database (Del)" Click="OnDeleteStudy" Foreground="#FF5252" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- Reviewed Checkmark column -->
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnToggleStudyReviewedClick" ToolTip="Toggle Reviewed (Space)">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Visibility="{Binding IsReviewed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Stroke="#00E676" StrokeThickness="2.2" Data="M2,6 L5,9 L11,2" Width="13" Height="11" Stretch="Uniform" />
                                    <Path Visibility="{Binding IsReviewed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                          Stroke="#444444" StrokeThickness="1.2" Data="M2,6 L5,9 L11,2" Width="13" Height="11" Stretch="Uniform" Opacity="0.3" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Header="Study date" Binding="{Binding StudyDate}" Width="100" MinWidth="95" />
                <DataGridTextColumn Header="Time" Binding="{Binding FormattedTime}" Width="70" MinWidth="70" />
                <DataGridTemplateColumn Header="Patient name" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" 
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" 
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="120" />
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="70" />
                <DataGridTextColumn Header="Date of birth" Binding="{Binding DateOfBirth}" Width="95" />

                <DataGridTemplateColumn Header="Modality" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Modality, Converter={StaticResource ModalityToBackgroundConverter}}"
                                    BorderBrush="{Binding Modality, Converter={StaticResource ModalityToBorderBrushConverter}}"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Modality}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Modality, Converter={StaticResource ModalityToForegroundConverter}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Study description" Binding="{Binding StudyDescription}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Notes" Binding="{Binding PatientComments}" Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F5AF28" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding PatientComments}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PatientComments}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Reading physician" Binding="{Binding ReadingPhysician}" Width="135" />
                <DataGridTextColumn Header="Performing physician" Binding="{Binding PerformingPhysician}" Width="135" />
                <DataGridTextColumn Header="Referring physician" Binding="{Binding ReferringPhysician}" Width="135" />
                <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" SortMemberPath="SizeBytes" Width="80" MinWidth="70" />
                <DataGridTextColumn Header="Accession #" Binding="{Binding AccessionNumber}" Width="95" />
                <DataGridTextColumn Header="Images" Binding="{Binding TotalImages}" Width="65" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. GRID SPLITTER -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="#282828" Cursor="SizeNS" ResizeDirection="Rows" />

        <!-- 5. BOTTOM GRID: SERIES OF SELECTED STUDY -->
        <DataGrid Grid.Row="4" x:Name="GridSeries" SelectionMode="Extended" MouseDoubleClick="OnSeriesDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open selected series only" Click="OnOpenSelectedSeriesOnly" FontWeight="Bold" />
                    <MenuItem Header="Add series to current study" Click="OnAddSeriesToCurrentStudy" FontWeight="SemiBold" Foreground="#F5AF28" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding SeriesNumber}" Width="45" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
                <DataGridTextColumn Header="Time" Binding="{Binding FormattedTime}" Width="70" />
                <DataGridTextColumn Header="Number" Binding="{Binding SeriesNumber}" Width="65" />
                <DataGridTemplateColumn Header="Modality" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Modality, Converter={StaticResource ModalityToBackgroundConverter}}"
                                    BorderBrush="{Binding Modality, Converter={StaticResource ModalityToBorderBrushConverter}}"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Modality}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Modality, Converter={StaticResource ModalityToForegroundConverter}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Images" Binding="{Binding ImageCount}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 6. BOTTOM STATUS BAR -->
        <Border Grid.Row="5" Background="#181818" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11.5" Foreground="#888888" VerticalAlignment="Center" />
                <ProgressBar x:Name="PbTransfer" Width="180" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                             Background="#222222" Foreground="#F5AF28" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="TxtDbPath" DockPanel.Dock="Right" Text="" FontSize="11" Foreground="#666666" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
