<Window x:Class="OpenRadViewer.Views.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Local Database - Parsec DICOM Archive" 
        Height="680" Width="1280"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#222222" />
        <SolidColorBrush x:Key="AccentGold" Color="#F5AF28" />

        <!-- Force dark highlight colors when rows are selected or inactive -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#25384D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#25384D" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />

        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#383838" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#252525" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowBackground" Value="#181818" />
            <Setter Property="AlternatingRowBackground" Value="#1E1E1E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#25384D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#25384D" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </MultiTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202A36" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Status / Search Subbar -->
            <RowDefinition Height="*" MinHeight="150" />    <!-- Studies List -->
            <RowDefinition Height="5" />    <!-- Splitter -->
            <RowDefinition Height="180" MinHeight="100" />  <!-- Series List -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="4,3">
            <DockPanel LastChildFill="False">
                <!-- Clean Database Archive Icon -->
                <Button Style="{StaticResource ToolbarBtnStyle}" ToolTip="Parsec Local Database" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#F5AF28" StrokeThickness="1.4" Fill="Transparent" Data="M3,5 C3,3.5 7,2.5 12,2.5 C17,2.5 21,3.5 21,5 C21,6.5 17,7.5 12,7.5 C7,7.5 3,6.5 3,5 Z M3,5 L3,11 C3,12.5 7,13.5 12,13.5 C17,13.5 21,12.5 21,11 L21,5 M3,11 L3,17 C3,18.5 7,19.5 12,19.5 C17,19.5 21,18.5 21,17 L21,11" Width="15" Height="15" Stretch="Uniform" />
                        <TextBlock Text=" Database" FontSize="12" FontWeight="Bold" Margin="4,0,4,0" VerticalAlignment="Center" Foreground="#F5AF28" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="#333333" Margin="4,0" />

                <!-- Open in Viewer (Enter / Double-Click) -->
                <Button Style="{StaticResource ToolbarBtnStyle}" Click="OnOpenInViewer" ToolTip="Open selected study in Viewer (Enter / Double-Click)">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#72C6E8" StrokeThickness="1.4" Fill="Transparent" Data="M2,3 H18 V14 H2 Z M7,17 H13 M10,14 V17 M8,6 L13,8.5 L8,11 Z" Width="15" Height="15" Stretch="Uniform" />
                        <TextBlock Text=" Open in Viewer" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import DICOM Folder -->
                <Button Style="{StaticResource ToolbarBtnStyle}" Click="OnImportFolder" ToolTip="Import external DICOM folder to Database">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#CCCCCC" StrokeThickness="1.4" Fill="Transparent" Data="M2,5 C2,4 2.8,3.2 3.8,3.2 H7.5 L9.5,5.2 H16.2 C17.2,5.2 18,6 18,7 V15 C18,16 17.2,16.8 16.2,16.8 H3.8 C2.8,16.8 2,16 2,15 Z M10,8 V14 M7,11 H13" Width="15" Height="15" Stretch="Uniform" />
                        <TextBlock Text=" Import Folder" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import Current Active Study -->
                <Button Style="{StaticResource ToolbarBtnStyle}" Click="OnImportActiveStudy" ToolTip="Save current open study into Database archive">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64D2B4" StrokeThickness="1.4" Fill="Transparent" Data="M3,3 H17 V17 H3 Z M6,3 V7 H14 V3 M10,10 V14 M7.5,12 L10,14.5 L12.5,12" Width="14" Height="14" Stretch="Uniform" />
                        <TextBlock Text=" Import Current Study" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Send Selected Study/Studies to PACS -->
                <Button x:Name="BtnSendToPacs" Style="{StaticResource ToolbarBtnStyle}" Click="OnSendToPacsClick" ToolTip="Send selected study or multiple studies to a PACS server (C-STORE)">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#F5AF28" StrokeThickness="1.5" Fill="Transparent" Data="M9,14 V4 M5.5,7.5 L9,4 L12.5,7.5 M3,13 V16 H15 V13" Width="14" Height="14" Stretch="Uniform" />
                        <TextBlock Text=" Send to PACS" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,2,0" VerticalAlignment="Center" Foreground="#F5AF28" />
                        <Path Fill="#888888" Data="M0,0 L6,0 L3,4 Z" Width="6" Height="4" Margin="2,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="#333333" Margin="4,0" />

                <!-- Mark as Reviewed / Done Toggle -->
                <Button Style="{StaticResource ToolbarBtnStyle}" Click="OnToggleReviewed" ToolTip="Toggle Reviewed / Done status (Space)">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#64D2B4" StrokeThickness="1.8" Fill="Transparent" Data="M2,7 L6,11 L14,3" Width="14" Height="13" Stretch="Uniform" />
                        <TextBlock Text=" Reviewed" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Delete from Database -->
                <Button Style="{StaticResource ToolbarBtnStyle}" Click="OnDeleteStudy" ToolTip="Delete selected study from Database (Del)">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#EF9A9A" StrokeThickness="1.4" Fill="Transparent" Data="M2,5 H16 M6,5 V3 H12 V5 M4,5 L5,16 H13 L14,5 M7,8 V13 M11,8 V13" Width="13" Height="14" Stretch="Uniform" />
                        <TextBlock Text=" Delete" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#EF9A9A" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Background="#333333" Margin="4,0" />

                <!-- Clear Entire Database -->
                <Button Style="{StaticResource ToolbarBtnStyle}" Click="OnClearAllDatabase" ToolTip="Clear entire local Database (Delete all studies and files)">
                    <StackPanel Orientation="Horizontal">
                        <Path Stroke="#EF5350" StrokeThickness="1.4" Fill="Transparent" Data="M3,6 H21 M19,6 L18,20 H6 L5,6 M10,10 V16 M14,10 V16 M9,6 V4 H15 V6" Width="13" Height="14" Stretch="Uniform" />
                        <TextBlock Text=" Clear Database" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#EF5350" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>


        <!-- 2. STATUS / SEARCH SUB-BAR -->
        <Border Grid.Row="1" Background="#1C1C1C" BorderBrush="#262626" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Database Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Fill="#F5AF28" Data="M8,1 A7,7 0 1,0 15,8 L8,8 Z" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock x:Name="TxtDbSummary" Text="Loading studies..." FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Search Box -->
                <Border Grid.Column="1" Background="#262626" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="3" Width="260" Padding="4,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Stroke="#888888" StrokeThickness="1.4" Data="M6,6 A4,4 0 1,1 10,10 M10,10 L13,13" Width="12" Height="12" VerticalAlignment="Center" Margin="2,0,4,0" />
                        <TextBox Grid.Column="1" x:Name="TxtSearch" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0"
                                 FontSize="11.5" VerticalAlignment="Center" TextChanged="OnSearchTextChanged" />
                        <TextBlock Grid.Column="1" Text="Search all studies..." Foreground="#666666" FontSize="11.5" 
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}" />
                        <Button Grid.Column="2" Style="{StaticResource ToolbarBtnStyle}" Padding="2" Click="OnClearSearch"
                                Visibility="{Binding Text.IsEmpty, ElementName=TxtSearch, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Path Stroke="#888888" StrokeThickness="1.4" Data="M2,2 L8,8 M8,2 L2,8" Width="9" Height="9" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. TOP GRID: STUDIES -->
        <DataGrid Grid.Row="2" x:Name="GridStudies" SelectionMode="Extended" SelectionUnit="FullRow"
                  SelectionChanged="OnStudySelectionChanged"
                  MouseDoubleClick="OnStudyDoubleClick" KeyDown="OnGridStudiesKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in Viewer (Enter)" Click="OnOpenInViewer" />
                    <MenuItem Header="Send to PACS..." Click="OnSendToPacsClick" FontWeight="SemiBold" Foreground="#F5AF28" />
                    <MenuItem Header="Reviewed (Space)" Click="OnToggleReviewed" />
                    <Separator />
                    <MenuItem Header="Delete from Database (Del)" Click="OnDeleteStudy" Foreground="#FF5252" />
                    <MenuItem Header="Clear Entire Database..." Click="OnClearAllDatabase" Foreground="#EF5350" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- Reviewed Checkmark column -->
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnToggleStudyReviewedClick" ToolTip="Toggle Reviewed (Space)">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Visibility="{Binding IsReviewed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Stroke="#00E676" StrokeThickness="2.2" Data="M2,6 L5,9 L11,2" Width="13" Height="11" Stretch="Uniform" />
                                    <Path Visibility="{Binding IsReviewed, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                          Stroke="#444444" StrokeThickness="1.2" Data="M2,6 L5,9 L11,2" Width="13" Height="11" Stretch="Uniform" Opacity="0.3" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Header="Study date" Binding="{Binding StudyDate}" Width="100" />
                <DataGridTemplateColumn Header="Patient name" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" 
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" 
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="120" />
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="70" />
                <DataGridTextColumn Header="Date of birth" Binding="{Binding DateOfBirth}" Width="95" />

                <DataGridTemplateColumn Header="Modality" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Modality, Converter={StaticResource ModalityToBackgroundConverter}}"
                                    BorderBrush="{Binding Modality, Converter={StaticResource ModalityToBorderBrushConverter}}"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Modality}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Modality, Converter={StaticResource ModalityToForegroundConverter}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Study description" Binding="{Binding StudyDescription}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Reading physician" Binding="{Binding ReadingPhysician}" Width="135" />
                <DataGridTextColumn Header="Performing physician" Binding="{Binding PerformingPhysician}" Width="135" />
                <DataGridTextColumn Header="Referring physician" Binding="{Binding ReferringPhysician}" Width="135" />
                <DataGridTextColumn Header="Accession #" Binding="{Binding AccessionNumber}" Width="95" />
                <DataGridTextColumn Header="Images" Binding="{Binding TotalImages}" Width="65" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. GRID SPLITTER -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="#282828" Cursor="SizeNS" ResizeDirection="Rows" />

        <!-- 5. BOTTOM GRID: SERIES OF SELECTED STUDY -->
        <DataGrid Grid.Row="4" x:Name="GridSeries" SelectionMode="Single" MouseDoubleClick="OnSeriesDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding SeriesNumber}" Width="45" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
                <DataGridTextColumn Header="Number" Binding="{Binding SeriesNumber}" Width="65" />
                <DataGridTemplateColumn Header="Modality" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Modality, Converter={StaticResource ModalityToBackgroundConverter}}"
                                    BorderBrush="{Binding Modality, Converter={StaticResource ModalityToBorderBrushConverter}}"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Modality}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Modality, Converter={StaticResource ModalityToForegroundConverter}}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Images" Binding="{Binding ImageCount}" Width="75" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 6. BOTTOM STATUS BAR -->
        <Border Grid.Row="5" Background="#181818" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11.5" Foreground="#888888" VerticalAlignment="Center" />
                <ProgressBar x:Name="PbTransfer" Width="180" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                             Background="#222222" Foreground="#F5AF28" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="TxtDbPath" DockPanel.Dock="Right" Text="" FontSize="11" Foreground="#666666" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
