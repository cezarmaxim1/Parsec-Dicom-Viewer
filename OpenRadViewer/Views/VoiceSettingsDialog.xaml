<Window x:Class="OpenRadViewer.Views.VoiceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Dictation &amp; AI Settings" 
        Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#141414" Foreground="#E0E0E0"
        ResizeMode="CanResizeWithGrip" MinWidth="580" MinHeight="500">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Medical Voice Dictation &amp; AI Settings" FontSize="16" FontWeight="Bold" Foreground="#F5AF28" />
            <TextBlock Text="Configure speech recognition, reference vocabulary, and persistent AI rules for maximum accuracy:" FontSize="11.5" Foreground="#A0A0A0" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- 1. Gemini AI Option -->
                <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🌟 Google Gemini AI (High Precision Dictation)" FontWeight="Bold" Foreground="#42A5F5" FontSize="12.5" Margin="0,0,0,4" />
                        <TextBlock Text="Accurately recognizes medical and radiological terminology in Romanian and English. Requires a free API key from aistudio.google.com."
                                   FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gemini Model:" FontSize="11.5" FontWeight="SemiBold" Foreground="#D0D0D0" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ComboBox Grid.Column="1" x:Name="ComboGeminiModel"
                                      Height="27" IsEditable="True"
                                      Background="#101010" Foreground="#FFFFFF" BorderBrush="#444444"
                                      FontSize="11.5" ToolTip="Select from list or type any custom Gemini model (e.g. gemini-3.8-flash)">
                                <ComboBox.Resources>
                                    <!-- Explicit TextBox style ensuring visible bright white text on dark background -->
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#101010" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="CaretBrush" Value="#42A5F5" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="FontSize" Value="11.5" />
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Gemini API Key:" FontSize="11.5" FontWeight="SemiBold" Foreground="#D0D0D0" Margin="0,4,0,4" />
                        <TextBox x:Name="TxtGeminiKey" Height="27" Background="#101010" Foreground="#FFFFFF" BorderBrush="#444444" Padding="6,3" FontSize="11.5" />
                    </StackPanel>
                </Border>

                <!-- 2. Reference Documents (PDF, DOCX, TXT) -->
                <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📚 Reference Reports &amp; Vocabulary (PDF / DOCX / TXT)" FontWeight="Bold" Foreground="#E0B020" FontSize="12.5" Margin="0,0,0,4" />
                        <TextBlock Text="Parsec uses previous reports placed in this folder as vocabulary and style models for accurate terminology recognition."
                                   FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtRefFilesCount" Text="Reference files loaded: ..." FontSize="11" Foreground="#66BB6A" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="📂 Open Reference Folder" Click="OnOpenRefFolder" Padding="12,5" Background="#262626" Foreground="#E0E0E0" BorderBrush="#444444" ToolTip="Open folder to drop PDF, DOCX, or TXT files of previous reports" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Persistent AI Rules & Preferences -->
                <Border Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="14">
                    <StackPanel>
                        <TextBlock Text="📋 Persistent AI Reporting Rules &amp; Preferences" FontWeight="Bold" Foreground="#81D4FA" FontSize="12.5" Margin="0,0,0,4" />
                        <TextBlock Text="Enter custom rules that AI will permanently remember and apply to all report generation and refinements (e.g. conclusion formatting, brevity, phrasing):"
                                   FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBox x:Name="TxtCustomAiRules" Height="95"
                                 Background="#101010" Foreground="#FFFFFF" BorderBrush="#444444"
                                 Padding="8,6" FontSize="11.5" FontFamily="Segoe UI, Consolas"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Type one rule per line (e.g. 'Concluziile pe scurt.', 'Fara &quot;-&quot; inainte la concluzii.')" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,10,0" Padding="16,6" Background="#303030" Foreground="#D0D0D0" BorderBrush="#444444" />
            <Button Content="Save Settings" Click="OnSave" Padding="20,6" Background="#F5AF28" Foreground="Black" FontWeight="Bold" BorderBrush="#F5AF28" />
        </StackPanel>
    </Grid>
</Window>
