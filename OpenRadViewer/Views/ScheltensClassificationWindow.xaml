<Window x:Class="OpenRadViewer.Views.ScheltensClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheltens Classification (MTA Scale)"
        Height="740" Width="1060"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GradeCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Image & Classification -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#6A1B9A" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="T1 CORONAL MRI" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock Text="Scheltens Classification (MTA Scale)" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Text="Visual rating scale for Medial Temporal lobe Atrophy in cognitive impairment &amp; Alzheimer's disease (Scheltens et al.)"
                               FontSize="11" Foreground="#999999" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close" Style="{StaticResource ActionButton}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Split: Left Image, Right Classification Table) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Reference Diagram Image (Fit to Screen) -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid Margin="6">
                    <Image x:Name="ScheltensImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#262626" />

            <!-- RIGHT: Classification Criteria & Diagnostic Cutoffs -->
            <Border Grid.Column="2" Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MEDIAL TEMPORAL LOBE ATROPHY (MTA) CRITERIA" FontWeight="Bold" FontSize="11" Foreground="#888888" Margin="0,0,0,10" />

                        <!-- Score 0: MTA 0 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#00897B">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#00897B" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="MTA 0" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Normal" FontWeight="SemiBold" Foreground="#4DB6AC" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Hippocampus: Normal" FontSize="10" FontWeight="SemiBold" Foreground="#80CBC4" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Choroid fissure: Normal&#x0a;• Temporal horn: Normal (slit-like / not visible)&#x0a;• Hippocampal height: Normal volume &amp; thickness"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 1: MTA 1 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#0288D1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0288D1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="MTA 1" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Mild Widening" FontWeight="SemiBold" Foreground="#29B6F6" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Hippocampus: Normal" FontSize="10" FontWeight="SemiBold" Foreground="#81D4FA" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Choroid fissure: Mildly widened&#x0a;• Temporal horn: Normal&#x0a;• Hippocampal height: Normal volume"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 2: MTA 2 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#FBC02D">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FBC02D" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="MTA 2" FontWeight="Bold" FontSize="11" Foreground="#212121" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Moderate Atrophy" FontWeight="SemiBold" Foreground="#FFEE58" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Hippocampus: Mildly Decreased" FontSize="10" FontWeight="SemiBold" Foreground="#FFF59D" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Choroid fissure: Moderately widened&#x0a;• Temporal horn: Mildly widened&#x0a;• Hippocampal height: Mildly decreased"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 3: MTA 3 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#F57C00">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F57C00" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="MTA 3" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Pronounced Atrophy" FontWeight="SemiBold" Foreground="#FFA726" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Hippocampus: Moderately Decreased" FontSize="10" FontWeight="SemiBold" Foreground="#FFCC80" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Choroid fissure: Markedly widened&#x0a;• Temporal horn: Moderately widened&#x0a;• Hippocampal height: Moderately decreased"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Score 4: MTA 4 -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#D32F2F">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#D32F2F" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="MTA 4" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Severe / End-Stage" FontWeight="SemiBold" Foreground="#EF5350" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Hippocampus: Markedly Decreased" FontSize="10" FontWeight="SemiBold" Foreground="#EF9A9A" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Choroid fissure: Markedly widened (cavernous)&#x0a;• Temporal horn: Markedly widened&#x0a;• Hippocampal height: Markedly decreased (flat parenchyma)"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- AGE-SPECIFIC CLINICAL CUTOFFS -->
                        <Border Background="#162933" BorderBrush="#00838F" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="🧠 CLINICAL CUTOFFS &amp; DIAGNOSTIC INTERPRETATION" FontWeight="Bold" FontSize="10" Foreground="#00E5FF" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" Foreground="#B0BEC5" LineHeight="17">
                                    <Run FontWeight="SemiBold" Foreground="#FFFFFF">• Age &lt; 75 years:</Run> Score of <Run FontWeight="Bold" Foreground="#FFB74D">≥ 2</Run> is abnormal (pathological atrophy).&#x0a;
                                    <Run FontWeight="SemiBold" Foreground="#FFFFFF">• Age ≥ 75 years:</Run> Score of <Run FontWeight="Bold" Foreground="#E57373">≥ 3</Run> is abnormal (score of 2 can occur in normal aging).&#x0a;
                                    <Run FontWeight="SemiBold" Foreground="#FFFFFF">• Best assessed on:</Run> Coronal 3D T1-weighted MPR / T1 SE perpendicular to the long axis of hippocampus at the level of anterior pons.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
