<Window x:Class="OpenRadViewer.Views.CustomWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window / Level &amp; Custom Presets"
        Height="440" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Window / Level &amp; Custom Presets" FontSize="14" FontWeight="Bold" Foreground="#F5AF28" Margin="0,0,0,12" />

        <!-- Numeric Inputs & Save Option -->
        <Border Grid.Row="1" Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Window Center (WL):" VerticalAlignment="Center" Margin="0,4" Foreground="#CCCCCC" />
                    <TextBox x:Name="TxtCenter" Grid.Row="0" Grid.Column="1" Background="#2A2A2A" Foreground="White" BorderBrush="#444444" Padding="6,4" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Window Width (WW):" VerticalAlignment="Center" Margin="0,4" Foreground="#CCCCCC" />
                    <TextBox x:Name="TxtWidth" Grid.Row="1" Grid.Column="1" Background="#2A2A2A" Foreground="White" BorderBrush="#444444" Padding="6,4" Margin="0,4" />

                    <CheckBox x:Name="ChkSavePreset" Grid.Row="2" Grid.ColumnSpan="2" Content="Save as permanent custom preset" 
                              Checked="OnSavePresetChecked" Unchecked="OnSavePresetUnchecked"
                              Foreground="#00E5FF" Margin="0,8,0,4" FontWeight="SemiBold" Cursor="Hand" />

                    <TextBlock x:Name="LblPresetName" Grid.Row="3" Grid.Column="0" Text="Preset Name:" VerticalAlignment="Center" Margin="0,4" Foreground="#AAAAAA" Visibility="Collapsed" />
                    <TextBox x:Name="TxtPresetName" Grid.Row="3" Grid.Column="1" Background="#2A2A2A" Foreground="White" BorderBrush="#00E5FF" Padding="6,4" Margin="0,4" Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Existing Custom Presets List -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Saved Custom Presets:" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,4" />

            <Border Grid.Row="1" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="3">
                <ListBox x:Name="LstCustomPresets" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0"
                         SelectionChanged="OnPresetSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="8,0" />
                                <Button Grid.Column="2" Content="✕" Click="OnDeletePreset" Tag="{Binding Id}"
                                        Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" Padding="6,0" Cursor="Hand"
                                        ToolTip="Delete this custom preset" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" Padding="14,6" Background="#303030" Foreground="#D0D0D0" BorderBrush="#444444" Cursor="Hand" />
            <Button Content="Apply" Click="OnApply" IsDefault="True" Padding="20,6" Background="#F5AF28" Foreground="Black" FontWeight="Bold" BorderBrush="#F5AF28" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
