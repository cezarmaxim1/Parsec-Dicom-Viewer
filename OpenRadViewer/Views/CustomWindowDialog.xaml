<Window x:Class="OpenRadViewer.Views.CustomWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Window / Level"
        Height="240" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Custom Window / Level Settings" FontSize="14" FontWeight="Bold" Foreground="#F5AF28" Margin="0,0,0,14" />

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Window Center (WL):" VerticalAlignment="Center" Margin="0,4" />
            <TextBox x:Name="TxtCenter" Grid.Row="0" Grid.Column="1" Background="#262626" Foreground="White" BorderBrush="#444444" Padding="6,3" Margin="0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Window Width (WW):" VerticalAlignment="Center" Margin="0,4" />
            <TextBox x:Name="TxtWidth" Grid.Row="1" Grid.Column="1" Background="#262626" Foreground="White" BorderBrush="#444444" Padding="6,3" Margin="0,4" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" Padding="14,5" Background="#303030" Foreground="#D0D0D0" BorderBrush="#444444" />
            <Button Content="Apply" Click="OnApply" Padding="18,5" Background="#F5AF28" Foreground="Black" FontWeight="Bold" BorderBrush="#F5AF28" />
        </StackPanel>
    </Grid>
</Window>
