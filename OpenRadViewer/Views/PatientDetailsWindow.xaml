<Window x:Class="OpenRadViewer.Views.PatientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient &amp; Study Details - Parsec"
        Height="540" Width="700"
        MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#141414" Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Value Style -->
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Clickable Copy Value Style -->
        <Style x:Key="ClickableValueCard" TargetType="Border">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A" />
                    <Setter Property="BorderBrush" Value="#00E5FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383838" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#606060" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#484848" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Background" Value="#1C2D35" />
            <Setter Property="BorderBrush" Value="#00E5FF" />
            <Setter Property="Foreground" Value="#00E5FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Cards -->
            <RowDefinition Height="Auto" /> <!-- Notice -->
            <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="38" Height="38" CornerRadius="6" Background="#222222" BorderBrush="#333333" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                <Path Stroke="#00E5FF" StrokeThickness="1.5" Data="M8,2 A3,3 0 1,0 8,8 A3,3 0 1,0 8,2 M2,14 C2,10.5 5,9.5 8,9.5 C11,9.5 14,10.5 14,14" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Patient &amp; Study Details" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Clinical identification, examination parameters and radiation dosimetry" FontSize="11.5" Foreground="#888888" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 2. CONTENT CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
            <StackPanel>
                <!-- CARD 1: PATIENT IDENTIFICATION -->
                <Border Style="{StaticResource DetailCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="PATIENT IDENTIFICATION" FontSize="11" FontWeight="Bold" Foreground="#F5AF28" VerticalAlignment="Center" />
                            <TextBlock Text="(Click any field below to copy to clipboard)" FontSize="10.5" Foreground="#777777" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Last Name (Clickable) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="LAST NAME (NUME)" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource ClickableValueCard}" MouseLeftButtonUp="OnCopyLastName" ToolTip="Click to copy Last Name">
                                    <DockPanel>
                                        <Path Fill="#555555" Data="M4,2 L10,2 A1,1 0 0,1 11,3 L11,9 A1,1 0 0,1 10,10 L4,10 A1,1 0 0,1 3,9 L3,3 A1,1 0 0,1 4,2 Z" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtLastName" Text="-" Foreground="#00E5FF" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- First Name (Clickable) -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="FIRST NAME (PRENUME)" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource ClickableValueCard}" MouseLeftButtonUp="OnCopyFirstName" ToolTip="Click to copy First Name">
                                    <DockPanel>
                                        <Path Fill="#555555" Data="M4,2 L10,2 A1,1 0 0,1 11,3 L11,9 A1,1 0 0,1 10,10 L4,10 A1,1 0 0,1 3,9 L3,3 A1,1 0 0,1 4,2 Z" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtFirstName" Text="-" Foreground="#00E5FF" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- CNP / Patient ID (Clickable) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="CNP / PATIENT ID" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource ClickableValueCard}" MouseLeftButtonUp="OnCopyCnp" ToolTip="Click to copy CNP / Patient ID">
                                    <DockPanel>
                                        <Path Fill="#555555" Data="M4,2 L10,2 A1,1 0 0,1 11,3 L11,9 A1,1 0 0,1 10,10 L4,10 A1,1 0 0,1 3,9 L3,3 A1,1 0 0,1 4,2 Z" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtCnp" Text="-" Foreground="#00E676" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Age (Clickable) - Sex/Gender removed -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="AGE (VÂRSTĂ)" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource ClickableValueCard}" MouseLeftButtonUp="OnCopyAge" ToolTip="Click to copy Age">
                                    <DockPanel>
                                        <Path Fill="#555555" Data="M4,2 L10,2 A1,1 0 0,1 11,3 L11,9 A1,1 0 0,1 10,10 L4,10 A1,1 0 0,1 3,9 L3,3 A1,1 0 0,1 4,2 Z" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtAge" Text="-" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Date of Birth -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="DATE OF BIRTH" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="TxtBirthDate" Text="-" Style="{StaticResource FieldValue}" Margin="4,2,0,0" />
                            </StackPanel>

                            <!-- Raw DICOM Name -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="RAW DICOM NAME" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="TxtRawName" Text="-" Style="{StaticResource FieldValue}" Foreground="#AAAAAA" FontSize="12" Margin="4,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: STUDY PARAMETERS & DOSIMETRY -->
                <Border Style="{StaticResource DetailCard}">
                    <StackPanel>
                        <TextBlock Text="STUDY PARAMETERS &amp; RADIATION DOSIMETRY (CT / MRI)" FontSize="11" FontWeight="Bold" Foreground="#F5AF28" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Study Date & Time -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="STUDY DATE &amp; TIME" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="TxtStudyDate" Text="-" Style="{StaticResource FieldValue}" Margin="4,2,0,0" />
                            </StackPanel>

                            <!-- Total DLP -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="TOTAL DLP (DOSE LENGTH PRODUCT)" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="TxtTotalDlp" Text="-" Style="{StaticResource FieldValue}" Foreground="#FFB300" FontWeight="Bold" FontSize="14" Margin="4,2,0,0" />
                            </StackPanel>

                            <!-- Scan Type (Contrast media) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                <TextBlock Text="SCAN TYPE (CONTRAST MEDIA PROTOCOL)" Style="{StaticResource FieldLabel}" />
                                <Border Background="#252525" CornerRadius="4" Padding="10,6" Margin="0,3,0,0">
                                    <TextBlock x:Name="TxtScanType" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- Study Description -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="STUDY DESCRIPTION" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="TxtStudyDesc" Text="-" Style="{StaticResource FieldValue}" Margin="4,2,0,0" />
                            </StackPanel>

                            <!-- Modality & Series -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="MODALITY &amp; SERIES" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="TxtModalityAndSeries" Text="-" Style="{StaticResource FieldValue}" Margin="4,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. NOTIFICATION BANNER -->
        <Border Grid.Row="2" x:Name="NoticeContainer" Background="#1B3828" BorderBrush="#00E676" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Fill="#00E676" Data="M2,6 L5,9 L12,2" Stroke="#00E676" StrokeThickness="1.5" Width="12" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtNoticeMessage" Text="Copied to clipboard" FontSize="11.5" FontWeight="SemiBold" Foreground="#00E676" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 4. FOOTER BUTTONS -->
        <Border Grid.Row="3" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <DockPanel LastChildFill="False">
                <!-- General Summary Copy (Image 3 format with 5 tabs) -->
                <Button Style="{StaticResource PrimaryActionBtn}" Click="OnCopySummary" Margin="0,0,8,0" 
                        ToolTip="Copy summary formatted with 5 tabs between columns (Nume, CNP, Prenume, Vârsta)">
                    <StackPanel Orientation="Horizontal">
                        <Path Fill="#00E5FF" Data="M4,2 L12,2 A1,1 0 0,1 13,3 L13,11 A1,1 0 0,1 12,12 L4,12 A1,1 0 0,1 3,11 L3,3 A1,1 0 0,1 4,2 Z M6,6 L15,6 A1,1 0 0,1 16,7 L16,15 A1,1 0 0,1 15,16 L6,16 A1,1 0 0,1 5,15 L5,7 A1,1 0 0,1 6,6 Z" Width="13" Height="13" Stretch="Uniform" />
                        <TextBlock Text=" Copy Patient Summary" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Full Metadata Copy -->
                <Button Style="{StaticResource DialogBtn}" Click="OnCopyAllDetails" ToolTip="Copy complete patient, study and dosimetry parameters">
                    <StackPanel Orientation="Horizontal">
                        <Path Fill="#AAAAAA" Data="M4,2 L12,2 A1,1 0 0,1 13,3 L13,11 A1,1 0 0,1 12,12 L4,12 A1,1 0 0,1 3,11 L3,3 A1,1 0 0,1 4,2 Z" Width="12" Height="12" Stretch="Uniform" />
                        <TextBlock Text=" Copy All Details" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource DialogBtn}" Click="OnClose" Content="Close" Width="85" IsDefault="True" IsCancel="True" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
