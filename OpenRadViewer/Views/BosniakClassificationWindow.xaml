<Window x:Class="OpenRadViewer.Views.BosniakClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bosniak Classification (Cystic Renal Masses)"
        Height="760" Width="1080"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GradeCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Image & Classification -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#C62828" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="CT / MRI KIDNEY" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock Text="Bosniak Classification (Cystic Renal Masses)" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Text="Stratification of malignancy risk &amp; clinical management for renal cysts and cystic renal cell carcinoma"
                               FontSize="11" Foreground="#999999" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close" Style="{StaticResource ActionButton}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Split: Left Image, Right Classification Table) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Reference Diagram Image -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid Margin="6">
                    <Image x:Name="BosniakImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#262626" />

            <!-- RIGHT: Classification Criteria & Diagnostic Cutoffs -->
            <Border Grid.Column="2" Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="BOSNIAK CATEGORIES &amp; MALIGNANCY RISK" FontWeight="Bold" FontSize="11" Foreground="#888888" Margin="0,0,0,10" />

                        <!-- Bosniak I -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#00897B">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#00897B" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Class I" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Benign Simple Cyst" FontWeight="SemiBold" Foreground="#4DB6AC" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Risk: 0%" FontSize="10" FontWeight="Bold" Foreground="#80CBC4" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Wall: Hairline-thin (≤2 mm)&#x0a;• Septa: No septa, no calcifications, no solid elements&#x0a;• Density: Water attenuation (-9 to 20 HU), no enhancement&#x0a;• Management: No follow-up needed"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Bosniak II -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#00ACC1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#00ACC1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Class II" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Minimally Complex Benign Cyst" FontWeight="SemiBold" Foreground="#26C6DA" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Risk: 0 – 6%" FontSize="10" FontWeight="Bold" Foreground="#80DEEA" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Wall: Thin wall (≤2 mm)&#x0a;• Septa: Thin septa (&lt;2 mm) and only 1 – 3 septa&#x0a;• Calcifications: Fine or small calcifications in wall or septa&#x0a;• Also includes: Hyperdense cysts &lt;3 cm without enhancement&#x0a;• Management: No follow-up needed"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Bosniak IIF -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#FBC02D">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FBC02D" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Class IIF" FontWeight="Bold" FontSize="11" Foreground="#212121" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Minimally Complex (Follow-up)" FontWeight="SemiBold" Foreground="#FFEE58" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Risk: 5 – 26%" FontSize="10" FontWeight="Bold" Foreground="#FFF59D" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Wall/Septa: Thicker wall or septa (~3 mm) OR &gt;4 thin septa&#x0a;• Calcifications: Thick or nodular calcifications (no soft tissue enhancement)&#x0a;• Also includes: Completely intrarenal hyperdense cysts ≥3 cm&#x0a;• Management: SURVEILLANCE (CT/MRI at 6 and 12 mo, then annually for 5 years)"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Bosniak III -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#F57C00">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F57C00" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Class III" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Indeterminate Cystic Mass" FontWeight="SemiBold" Foreground="#FFA726" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Risk: 55 – 72%" FontSize="10" FontWeight="Bold" Foreground="#FFCC80" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Wall/Septa: Thick and/or irregular wall or septa (&gt;4 mm)&#x0a;• Enhancement: Measurable enhancement of walls or septa&#x0a;• Pathology: Multilocular cystic nephroma vs. Cystic RCC&#x0a;• Management: UROLOGY REFERRAL (Partial nephrectomy or ablation)"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Bosniak IV -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#D32F2F">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#D32F2F" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Class IV" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Clearly Malignant Cystic Mass" FontWeight="SemiBold" Foreground="#EF5350" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Risk: 91 – 100%" FontSize="10" FontWeight="Bold" Foreground="#EF9A9A" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Wall/Septa: Thick walls, thick irregular septa&#x0a;• Nodules: Enhancing soft tissue nodule(s) with convex/obtuse margins&#x0a;• Pathology: Cystic Renal Cell Carcinoma (cRCC)&#x0a;• Management: UROLOGY REFERRAL (Surgical resection / Nephrectomy)"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- CLINICAL DECISION FLOW -->
                        <Border Background="#1C2833" BorderBrush="#0288D1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="🎯 MANAGEMENT SUMMARY" FontWeight="Bold" FontSize="10" Foreground="#29B6F6" Margin="0,0,0,4" />
                                <TextBlock FontSize="11" Foreground="#B0BEC5" LineHeight="17">
                                    <Run FontWeight="SemiBold" Foreground="#81C784">• Class I &amp; II:</Run> Benign lesions $\rightarrow$ <Run FontWeight="Bold" Foreground="#FFFFFF">NO FOLLOW-UP</Run>&#x0a;
                                    <Run FontWeight="SemiBold" Foreground="#FFF176">• Class IIF:</Run> Equivocal risk (5-26%) $\rightarrow$ <Run FontWeight="Bold" Foreground="#FFFFFF">SURVEILLANCE</Run> (6, 12 mo, then yearly)&#x0a;
                                    <Run FontWeight="SemiBold" Foreground="#E57373">• Class III &amp; IV:</Run> High malignancy risk $\rightarrow$ <Run FontWeight="Bold" Foreground="#FFFFFF">UROLOGY REFERRAL</Run> (Surgical excision)
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
