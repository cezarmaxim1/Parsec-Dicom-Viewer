<UserControl x:Class="OpenRadViewer.Views.ViewportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OpenRadViewer.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ViewportViewModel}"
             Focusable="True"
             AllowDrop="True"
             Background="#0C0C0C">
    
    <Border x:Name="ViewportBorder" 
            BorderThickness="1" 
            BorderBrush="{Binding IsActive, Converter={StaticResource ActiveBorderConverter}}"
            ClipToBounds="True">
        
        <Grid x:Name="RootGrid" Background="Black">
            <!-- Medical Image Display Canvas / Viewport -->
            <Canvas x:Name="ImageCanvas" ClipToBounds="True">
                <Image x:Name="SliceImage" 
                       Source="{Binding DisplayImage}"
                       RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Unspecified"
                       Stretch="None">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
                            <RotateTransform Angle="{Binding RotationAngle}" />
                            <ScaleTransform ScaleX="{Binding FlipHorizontal, Converter={StaticResource BoolToScaleConverter}}"
                                            ScaleY="{Binding FlipVertical, Converter={StaticResource BoolToScaleConverter}}" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <!-- Measurement and ROI Canvas Layer -->
                <Canvas x:Name="MeasurementCanvas" IsHitTestVisible="False" />
                <!-- Interactive Overlay for Vertebra labels, badges, nudge buttons and in-place editors -->
                <Canvas x:Name="InteractiveOverlayCanvas" />
            </Canvas>

            <!-- Anatomical Orientation Letters (Centered on 4 Edges) -->
            <TextBlock Text="{Binding OrientationTop}" Foreground="#FFE87C" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False" />
            <TextBlock Text="{Binding OrientationBottom}" Foreground="#FFE87C" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False" />
            <TextBlock Text="{Binding OrientationLeft}" Foreground="#FFE87C" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
            <TextBlock Text="{Binding OrientationRight}" Foreground="#FFE87C" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />

            <!-- Vertical Scale Ruler on Left Border -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False">
                <Path x:Name="RulerPath" Stroke="#C8443B" StrokeThickness="1.5" VerticalAlignment="Center" />
                <TextBlock x:Name="RulerLabel" Foreground="#C8443B" FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>

            <!-- DICOM OSD Text Overlays (4 Corners) -->
            <!-- Top-Left Overlay -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="8" Height="8" Fill="{Binding MprBadgeBrush}" Margin="0,0,5,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center"
                               Visibility="{Binding IsMprViewport, Converter={StaticResource BooleanToVisibilityConverter}}"
                               IsHitTestVisible="False" />
                    <TextBlock Text="{Binding PatientName}" Foreground="#E0E0E0" FontWeight="Bold" FontSize="13"
                               Cursor="Hand" ToolTip="Right-click to copy patient name or CNP"
                               PreviewMouseRightButtonDown="OnPatientTextRightDown">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Patient Name" Click="OnCopyPatientName" />
                                <MenuItem Header="Copy CNP (Patient ID)" Click="OnCopyPatientId" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding PatientIdAndAgeOverlay}" Foreground="#A0A0A0" FontSize="11"
                           Cursor="Hand" ToolTip="Right-click to copy CNP or patient name"
                           PreviewMouseRightButtonDown="OnPatientTextRightDown">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy CNP (Patient ID)" Click="OnCopyPatientId" />
                            <MenuItem Header="Copy Patient Name" Click="OnCopyPatientName" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBlock Text="{Binding StudyDate}" Foreground="#A0A0A0" FontSize="11" IsHitTestVisible="False" />
                <TextBlock Text="{Binding ImageIndexOverlay}" Foreground="#FFA040" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" IsHitTestVisible="False" />
                <TextBlock Text="{Binding SeriesNumberOverlay}" Foreground="#FFD700" FontWeight="SemiBold" FontSize="13" IsHitTestVisible="False" />
                <TextBlock Text="{Binding SliceCommentOverlay}" Foreground="#40E0D0" FontWeight="Bold" FontSize="14" Margin="0,2,0,0" IsHitTestVisible="False" />
            </StackPanel>

            <!-- Top-Right Overlay & Close Series Button -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                <!-- Discrete Orange Close (X) Button (Transparent, minimal, visible when series is loaded) -->
                <Button x:Name="BtnCloseViewport"
                        Click="OnCloseViewportClicked"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,4"
                        Width="16" Height="16"
                        Cursor="Hand"
                        ToolTip="Close Series / Panel (Esc)"
                        Visibility="{Binding CurrentSeries, Converter={StaticResource NotNullToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path x:Name="XPath" Data="M2,2 L10,10 M10,2 L2,10" Stroke="#FFA500" StrokeThickness="1.6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="12" Height="12" Stretch="Uniform" Opacity="0.75" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="XPath" Property="Stroke" Value="#FFD54F" />
                                    <Setter TargetName="XPath" Property="Opacity" Value="1.0" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="XPath" Property="Stroke" Value="#FF8F00" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="{Binding CurrentSeries.DisplayTitle}" Foreground="#FFD700" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" IsHitTestVisible="False" />
                <TextBlock Text="{Binding SeriesTimeOverlay}" Foreground="#90CAF9" FontSize="11" HorizontalAlignment="Right" IsHitTestVisible="False" />
                <TextBlock Text="{Binding Modality}" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Right" IsHitTestVisible="False" />

                <!-- Borderless MPR / MIP / MinIP Selector right under Modality (CT/MR) -->
                <Border x:Name="BdSlabBadge"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0,1"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Visibility="{Binding ShowSlabBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                        PreviewMouseLeftButtonDown="OnSlabBadgeClick"
                        PreviewMouseRightButtonDown="OnSlabBadgeClick"
                        PreviewMouseWheel="OnSlabBadgeMouseWheel"
                        ToolTip="Click pentru selecție MPR / MIP / MinIP și cursor grosime (mm)&#x0a;Rotiță mouse: ajustează grosimea în mm">
                    <TextBlock x:Name="TxtSlabBadge" Text="{Binding SlabBadgeText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B0B0B0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSlabActive}" Value="True">
                                        <Setter Property="Foreground" Value="#00E5FF" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFD54F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Interactive Popup with Mode Buttons, Smooth Thickness Slider, and Normal Slice Reset -->
                <Popup x:Name="SlabPopup"
                       PlacementTarget="{Binding ElementName=BdSlabBadge}"
                       Placement="Bottom"
                       HorizontalOffset="-150"
                       VerticalOffset="4"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="#F218181C"
                            BorderBrush="#3E3E46"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Width="215">
                        <StackPanel>
                            <!-- Mode Buttons: MPR | MIP | MinIP -->
                            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                                <Button Content="MPR" Click="OnSelectModeAvg" Margin="0,0,3,0" Padding="0,4" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#26262B" />
                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                            <Setter Property="BorderBrush" Value="#3E3E46" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModeAvg}" Value="True">
                                                    <Setter Property="Background" Value="#0D3B4C" />
                                                    <Setter Property="Foreground" Value="#00E5FF" />
                                                    <Setter Property="BorderBrush" Value="#00E5FF" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="MIP" Click="OnSelectModeMip" Margin="1.5,0,1.5,0" Padding="0,4" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#26262B" />
                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                            <Setter Property="BorderBrush" Value="#3E3E46" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModeMip}" Value="True">
                                                    <Setter Property="Background" Value="#0D3B4C" />
                                                    <Setter Property="Foreground" Value="#00E5FF" />
                                                    <Setter Property="BorderBrush" Value="#00E5FF" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="MinIP" Click="OnSelectModeMinIp" Margin="3,0,0,0" Padding="0,4" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#26262B" />
                                            <Setter Property="Foreground" Value="#CCCCCC" />
                                            <Setter Property="BorderBrush" Value="#3E3E46" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModeMinIp}" Value="True">
                                                    <Setter Property="Background" Value="#0D3B4C" />
                                                    <Setter Property="Foreground" Value="#00E5FF" />
                                                    <Setter Property="BorderBrush" Value="#00E5FF" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <!-- Thickness Slider Header -->
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Grosime (Thickness):" Foreground="#B0B0B0" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SlabThicknessMm, StringFormat='{}{0:0.0} mm'}"
                                           Foreground="#00E5FF" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Interactive Thickness Slider (0 - 50 mm) -->
                            <Slider x:Name="SldSlabThickness"
                                    Minimum="0"
                                    Maximum="50"
                                    SmallChange="0.5"
                                    LargeChange="5"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"
                                    Value="{Binding SlabThicknessMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Cursor="Hand"
                                    Margin="0,2,0,8" />

                            <!-- Reset to Normal Slice Button -->
                            <Button Content="↺ Revenire la Slice Normal"
                                    Click="OnResetNormalSliceClick"
                                    Cursor="Hand"
                                    Padding="6,4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Background="#25252B"
                                    Foreground="#FFD54F"
                                    BorderBrush="#44444E"
                                    BorderThickness="1" />

                            <!-- Apply to all MPR planes (only when in 3D MPR) -->
                            <Button Content="Aplică pe toate planurile MPR"
                                    Click="OnApplySlabToAllMprPlanes"
                                    Visibility="{Binding IsMprViewport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Cursor="Hand"
                                    Margin="0,4,0,0"
                                    Padding="6,3"
                                    FontSize="10.5"
                                    Background="#1E1E24"
                                    Foreground="#90CAF9"
                                    BorderBrush="#33333D"
                                    BorderThickness="1" />
                        </StackPanel>
                    </Border>
                </Popup>

                <TextBlock Text="{Binding CurrentSlice.SequenceName}" Foreground="#808080" FontSize="10" HorizontalAlignment="Right" IsHitTestVisible="False" />
            </StackPanel>

            <!-- Bottom-Left Overlay -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" IsHitTestVisible="False">
                <TextBlock Text="{Binding WindowOverlay}" Foreground="#FFA040" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="{Binding ThicknessLocationOverlay}" Foreground="#80FF80" FontSize="11" />
            </StackPanel>

            <!-- Bottom-Right Overlay -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" IsHitTestVisible="False">
                <TextBlock Text="{Binding AcquisitionParamsOverlay}" Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Zoom, StringFormat='{}Zoom: {0:P0}'}" Foreground="#606060" FontSize="10" HorizontalAlignment="Right" />
            </StackPanel>

            <!-- Empty viewport placeholder if no series loaded -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                        Visibility="{Binding CurrentSeries, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="[Empty Viewport]" Foreground="#404040" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Text="Click or drag a series from the left panel" Foreground="#303030" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
