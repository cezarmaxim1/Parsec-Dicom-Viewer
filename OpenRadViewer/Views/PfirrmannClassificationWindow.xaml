<Window x:Class="OpenRadViewer.Views.PfirrmannClassificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pfirrmann Classification"
        Height="720" Width="1020"
        MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GradeCard" TargetType="Border">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Image & English Classification -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#00838F" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="T2 SAGITTAL MRI" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock Text="Pfirrmann Classification" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock Text="Grading system for intervertebral disc degeneration based on T2-weighted MRI (Pfirrmann et al.)"
                               FontSize="11" Foreground="#999999" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close" Style="{StaticResource ActionButton}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Split: Left Image, Right English Classification Table) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Reference Diagram Image (Fit to Screen, No Scroll) -->
            <Border Grid.Column="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid Margin="6">
                    <Image x:Name="PfirrmannImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#262626" />

            <!-- RIGHT: Classification Criteria in English -->
            <Border Grid.Column="2" Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CLASSIFICATION CRITERIA" FontWeight="Bold" FontSize="11" Foreground="#888888" Margin="0,0,0,10" />

                        <!-- Grade I -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#00897B">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#00897B" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Grade I" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Normal" FontWeight="SemiBold" Foreground="#4DB6AC" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Height: Normal" FontSize="10" FontWeight="SemiBold" Foreground="#80CBC4" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• T2 high signal homogeneous nucleus&#x0a;• Clear distinction of nucleus and annulus&#x0a;• Normal disc height"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Grade II -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#0288D1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0288D1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Grade II" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Normal" FontWeight="SemiBold" Foreground="#29B6F6" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Height: Normal" FontSize="10" FontWeight="SemiBold" Foreground="#81D4FA" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• T2 high signal nucleus with central horizontal T2 low signal line&#x0a;• Clear distinction of nucleus and annulus&#x0a;• Normal disc height"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Grade III -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#FBC02D">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#FBC02D" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Grade III" FontWeight="Bold" FontSize="11" Foreground="#212121" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Intermediate" FontWeight="SemiBold" Foreground="#FFEE58" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Height: Normal or slightly decreased" FontSize="10" FontWeight="SemiBold" Foreground="#FFF59D" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• T2 low signal inhomogeneous nucleus&#x0a;• Unclear distinction of nucleus and annulus&#x0a;• Normal or slightly decreased disc height"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Grade IV -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#F57C00">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F57C00" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Grade IV" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Moderately decreased" FontWeight="SemiBold" Foreground="#FFA726" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Height: Moderately decreased" FontSize="10" FontWeight="SemiBold" Foreground="#FFCC80" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Very low to moderate T2 signal inhomogeneous nucleus&#x0a;• Lost distinction of nucleus and annulus&#x0a;• Moderately decreased disc height"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Grade V -->
                        <Border Style="{StaticResource GradeCard}" BorderBrush="#D32F2F">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#D32F2F" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="Grade V" FontWeight="Bold" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Collapsed" FontWeight="SemiBold" Foreground="#EF5350" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Height: Collapsed" FontSize="10" FontWeight="SemiBold" Foreground="#EF9A9A" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="• Very low T2 signal inhomogeneous nucleus&#x0a;• Lost distinction of nucleus and annulus&#x0a;• Collapsed disc space"
                                           FontSize="11" Foreground="#CCCCCC" LineHeight="17" Margin="2,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
