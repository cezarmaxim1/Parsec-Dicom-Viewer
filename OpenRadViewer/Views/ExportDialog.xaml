<Window x:Class="OpenRadViewer.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Export Medical Images &amp; DICOM - Parsec" 
        Height="490" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="#141414" Foreground="#E0E0E0"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Export Medical Images &amp; Studies" FontSize="16" FontWeight="Bold" Foreground="#F5AF28" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <!-- Scope -->
            <TextBlock Text="Export Scope:" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel Orientation="Vertical" Margin="4,0,0,12">
                <RadioButton x:Name="RadioAllSeriesPatient" 
                             Content="Entire patient study (All Series)" 
                             IsChecked="True" 
                             Foreground="#FFFFFF" 
                             FontWeight="SemiBold" 
                             Margin="0,0,0,6" 
                             Checked="OnScopeChanged" />
                <RadioButton x:Name="RadioEntireSeries" 
                             Content="Active series only" 
                             Foreground="#D0D0D0" 
                             Margin="0,0,0,6" 
                             Checked="OnScopeChanged" />
                <RadioButton x:Name="RadioCurrentSlice" 
                             Content="Current slice / image only" 
                             Foreground="#D0D0D0" 
                             Margin="0,0,0,6" 
                             Checked="OnScopeChanged" />
                <TextBlock x:Name="TextScopeSummary" FontSize="11" Foreground="#A0A0A0" Margin="20,2,0,4" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Image Format -->
            <TextBlock Text="File Format:" FontWeight="SemiBold" Margin="0,4,0,6" />
            <ComboBox x:Name="ComboFormat" SelectedIndex="0" Width="220" HorizontalAlignment="Left" Margin="4,0,0,12" SelectionChanged="OnFormatChanged">
                <ComboBoxItem Content="DICOM (*.dcm) - Medical Standard" />
                <ComboBoxItem Content="PNG (*.png) - Lossless Image" />
                <ComboBoxItem Content="JPEG (*.jpg) - Compact Image" />
                <ComboBoxItem Content="TIFF (*.tif) - High Resolution" />
                <ComboBoxItem Content="BMP (*.bmp) - Uncompressed Bitmap" />
            </ComboBox>

            <!-- Options -->
            <TextBlock Text="Export Options:" FontWeight="SemiBold" Margin="0,4,0,6" />
            <StackPanel Margin="4,0,0,0">
                <CheckBox x:Name="CheckOrganizeFolders" Content="Organize into folders (Patient / Study / Series)" IsChecked="True" Foreground="#D0D0D0" Margin="0,2"
                          ToolTip="Creates a clean hierarchical folder structure: [PatientName_ID] / [Date_Study] / [Series]" />
                <CheckBox x:Name="CheckBurnOverlays" Content="Burn-in annotations on image (Name, ID, WL, scale)" IsChecked="False" Foreground="#D0D0D0" Margin="0,2" />
                <TextBlock x:Name="TextBurnOverlaysNote" Text="* Annotation burn-in is available for PNG, JPEG, and TIFF. DICOM files preserve standard medical metadata." 
                           FontSize="11" Foreground="#888888" Margin="20,0,0,4" Visibility="Collapsed" TextWrapping="Wrap" />
                <CheckBox x:Name="CheckAnonymize" Content="Anonymize patient data (DICOM tags)" IsChecked="False" Foreground="#D0D0D0" Margin="0,2" 
                          ToolTip="Replaces patient name and ID/CNP with anonymous values in exported DICOM files." />
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,10,0" Padding="14,6" Background="#303030" Foreground="#D0D0D0" BorderBrush="#444444" />
            <Button Content="Export..." Click="OnExport" Padding="20,6" Background="#F5AF28" Foreground="Black" FontWeight="Bold" BorderBrush="#F5AF28" />
        </StackPanel>
    </Grid>
</Window>
