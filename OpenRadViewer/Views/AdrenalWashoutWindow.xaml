<Window x:Class="OpenRadViewer.Views.AdrenalWashoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adrenal CT Washout Calculator"
        Height="540" Width="440"
        MinHeight="500" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        Topmost="True" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="InputCard" TargetType="Border">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3238" />
            <Setter Property="Foreground" Value="#00E5FF" />
            <Setter Property="BorderBrush" Value="#00838F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00838F" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Instructions -->
            <RowDefinition Height="Auto" />
            <!-- Inputs -->
            <RowDefinition Height="Auto" />
            <!-- Buttons & Target indicator -->
            <RowDefinition Height="Auto" />
            <!-- Results & Interpretation -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Adrenal CT Washout" FontSize="16" FontWeight="Bold" Foreground="#F5AF28" VerticalAlignment="Center" />
            <TextBlock Text=" (APW / RPW)" FontSize="13" Foreground="#999999" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Helper hint -->
        <TextBlock Grid.Row="1" Text="Type HU values or click &quot;Pick ROI&quot; to draw/select a circular ROI on the lesion."
                   FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Input Cards -->
        <StackPanel Grid.Row="2">
            <!-- 1. Pre-contrast / Native -->
            <Border x:Name="BorderPre" Style="{StaticResource InputCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="1. Pre-contrast (Native)" FontWeight="SemiBold" FontSize="12" Foreground="#E0E0E0" />
                        <TextBlock Text="Unenhanced baseline phase (Pre HU)" FontSize="10" Foreground="#888888" />
                    </StackPanel>
                    <TextBox x:Name="TxtPre" Grid.Column="1" Background="#181818" Foreground="#00E5FF" BorderBrush="#444444"
                             FontWeight="Bold" FontSize="13" TextAlignment="Right" Padding="6,4" VerticalAlignment="Center"
                             GotFocus="OnInputGotFocus" TextChanged="OnInputValueChanged" />
                    <Button x:Name="BtnPickPre" Grid.Column="2" Content="Pick ROI" Style="{StaticResource PickButton}" Margin="6,0,0,0"
                            Click="OnPickPreClicked" ToolTip="Draw or pick circular (ellipse) ROI on image to insert Mean HU" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 2. Portal Venous / Post-contrast -->
            <Border x:Name="BorderPortal" Style="{StaticResource InputCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="2. Portal Venous (Post-contrast)" FontWeight="SemiBold" FontSize="12" Foreground="#E0E0E0" />
                        <TextBlock Text="Portal-venous phase 60-70s (Post HU)" FontSize="10" Foreground="#888888" />
                    </StackPanel>
                    <TextBox x:Name="TxtPortal" Grid.Column="1" Background="#181818" Foreground="#00E5FF" BorderBrush="#444444"
                             FontWeight="Bold" FontSize="13" TextAlignment="Right" Padding="6,4" VerticalAlignment="Center"
                             GotFocus="OnInputGotFocus" TextChanged="OnInputValueChanged" />
                    <Button x:Name="BtnPickPortal" Grid.Column="2" Content="Pick ROI" Style="{StaticResource PickButton}" Margin="6,0,0,0"
                            Click="OnPickPortalClicked" ToolTip="Draw or pick circular (ellipse) ROI on image to insert Mean HU" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 3. Delayed / 15-min -->
            <Border x:Name="BorderDelayed" Style="{StaticResource InputCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="3. Delayed (15 min)" FontWeight="SemiBold" FontSize="12" Foreground="#E0E0E0" />
                        <TextBlock Text="15-minute delayed washout phase (Delayed HU)" FontSize="10" Foreground="#888888" />
                    </StackPanel>
                    <TextBox x:Name="TxtDelayed" Grid.Column="1" Background="#181818" Foreground="#00E5FF" BorderBrush="#444444"
                             FontWeight="Bold" FontSize="13" TextAlignment="Right" Padding="6,4" VerticalAlignment="Center"
                             GotFocus="OnInputGotFocus" TextChanged="OnInputValueChanged" />
                    <Button x:Name="BtnPickDelayed" Grid.Column="2" Content="Pick ROI" Style="{StaticResource PickButton}" Margin="6,0,0,0"
                            Click="OnPickDelayedClicked" ToolTip="Draw or pick circular (ellipse) ROI on image to insert Mean HU" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Quick Toolbar -->
        <DockPanel Grid.Row="3" Margin="0,2,0,10">
            <Button Content="Auto-detect from Viewports" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                    Click="OnAutoDetectClicked" ToolTip="Automatically detect ROIs from open Native, Portal, and Delayed series" />
            <Button Content="Reset" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="OnResetClicked" />
            <TextBlock x:Name="TxtTargetIndicator" Text="Active target: Native" Foreground="#00E5FF" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
        </DockPanel>

        <!-- Results Card -->
        <Border Grid.Row="4" Background="#1C1C1C" BorderBrush="#383838" BorderThickness="1" CornerRadius="5" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Absolute Washout -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Absolute Washout (APW)" FontWeight="SemiBold" FontSize="12" Foreground="#E0E0E0" />
                            <TextBlock Text="[(HU post - HU delayed) / (HU post - HU pre)] × 100" FontSize="10" Foreground="#777777" />
                            <TextBlock x:Name="TxtApwThreshold" Text="Threshold: ≥ 60% indicates adenoma" FontSize="10" Foreground="#888888" />
                        </StackPanel>
                        <TextBlock x:Name="TxtApwValue" Grid.Column="1" Text="-- %" FontSize="16" FontWeight="Bold"
                                   Foreground="#F5AF28" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <Separator Background="#2C2C2C" Margin="0,2,0,8" />

                    <!-- Relative Washout -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Relative Washout (RPW)" FontWeight="SemiBold" FontSize="12" Foreground="#E0E0E0" />
                            <TextBlock Text="[(HU post - HU delayed) / HU post] × 100" FontSize="10" Foreground="#777777" />
                            <TextBlock x:Name="TxtRpwThreshold" Text="Threshold: ≥ 40% indicates adenoma" FontSize="10" Foreground="#888888" />
                        </StackPanel>
                        <TextBlock x:Name="TxtRpwValue" Grid.Column="1" Text="-- %" FontSize="16" FontWeight="Bold"
                                   Foreground="#F5AF28" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <Separator Background="#2C2C2C" Margin="0,2,0,8" />

                    <!-- Diagnostic Conclusion Banner -->
                    <Border x:Name="BorderConclusion" Background="#222222" BorderBrush="#444444" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtConclusionTitle" Text="Enter HU values" FontWeight="Bold"
                                       FontSize="12" Foreground="#AAAAAA" />
                            <TextBlock x:Name="TxtConclusionBody"
                                       Text="Awaiting CT phases to compute adrenal contrast washout."
                                       FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="BtnCopy" Content="📋 Copy Report" Style="{StaticResource ActionButton}"
                    Background="#00838F" Foreground="White" BorderBrush="#006064"
                    Click="OnCopyClicked" ToolTip="Copy summary report to clipboard" />
            <Button Content="Close" Style="{StaticResource ActionButton}" DockPanel.Dock="Right"
                    Click="OnCloseClicked" />
        </DockPanel>
    </Grid>
</Window>
