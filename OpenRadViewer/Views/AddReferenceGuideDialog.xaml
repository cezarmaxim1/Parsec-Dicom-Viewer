<Window x:Class="OpenRadViewer.Views.AddReferenceGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Reference Guide"
        Height="480" Width="520"
        MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383838" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#666666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#D9971E" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#F5AF28" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Form -->
            <RowDefinition Height="Auto" /> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtDialogHeader" Text="Add New Reference" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock Text="Add a custom diagram, classification scheme, or reference table with an image." FontSize="11.5" Foreground="#888888" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Title / Name:" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,5" />
                <TextBox x:Name="TxtTitle" Margin="0,0,0,14" />

                <!-- Image Selection -->
                <TextBlock Text="Reference Image:" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,5" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtImagePath" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0" Foreground="#AAAAAA" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ActionButton}" Click="OnBrowseImageClick" />
                </Grid>

                <!-- Preview Box -->
                <Border Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Height="150" Margin="0,0,0,14">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4" />
                        <TextBlock x:Name="TxtNoPreview" Text="No image selected" Foreground="#666666" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Optional Notes -->
                <TextBlock Text="Description / Notes (Optional):" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,5" />
                <TextBox x:Name="TxtDescription" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="OnCancelClick" />
                <Button Content="Save Reference" Style="{StaticResource AccentButton}" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
