<Window x:Class="OpenRadViewer.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Configuration &amp; Reporting Style"
        Height="620" Width="680"
        MinHeight="520" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0"
        Topmost="True" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#00838F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#006064" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0097A7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Form body -->
            <RowDefinition Height="*" />
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,14">
            <DockPanel>
                <Border Background="#00838F" CornerRadius="4" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="AI ASSISTANT" FontWeight="Bold" FontSize="11" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI Provider, Model &amp; Custom Reporting Style" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" />
                    <TextBlock Text="Bring your own API Key (BYOK). Your key is stored securely and privately on this PC." FontSize="11" Foreground="#999999" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Provider & Model -->
                <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. AI Provider &amp; Model" FontWeight="Bold" FontSize="13" Foreground="#00E5FF" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Provider:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                            <ComboBox x:Name="ComboProvider" Grid.Column="1" Background="#181818" Foreground="#FFFFFF" Padding="6,4"
                                      SelectionChanged="OnProviderChanged">
                                <ComboBoxItem Content="Google Gemini (Recommended - Fast &amp; Free Tier)" Tag="Gemini" />
                                <ComboBoxItem Content="Anthropic Claude" Tag="Claude" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model Identifier:" VerticalAlignment="Center" Foreground="#CCCCCC" />
                            <ComboBox x:Name="ComboModel" Grid.Column="1" Background="#181818" Foreground="#FFFFFF" Padding="6,4" MaxDropDownHeight="320" />
                            <Button x:Name="BtnRefreshModels" Grid.Column="2" Content="🔄 Fetch Live Models" Style="{StaticResource ActionButton}"
                                    Margin="6,0,0,0" Padding="8,4" FontSize="11" Click="OnFetchModelsClick"
                                    ToolTip="Query the API with your key to list all current and latest models" />
                        </Grid>

                        <TextBlock x:Name="TxtModelsFetchedInfo" Text="Tip: Click '🔄 Fetch Live Models' or 'Test Key' to automatically pull the newest models from the API."
                                   FontSize="11" Foreground="#00E5FF" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- 2. API Key -->
                <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="2. API Key" FontWeight="Bold" FontSize="13" Foreground="#00E5FF" VerticalAlignment="Center" />
                            <Button Content="Get Free Gemini Key ↗" Style="{StaticResource ActionButton}" Padding="8,2" FontSize="11"
                                    HorizontalAlignment="Right" Click="OnGetApiKeyClick" ToolTip="Opens Google AI Studio (aistudio.google.com)" />
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="TxtApiKeyPassword" Background="#141414" Foreground="#00E5FF" BorderBrush="#444444"
                                         FontSize="13" Padding="8,5" VerticalAlignment="Center" PasswordChanged="OnPasswordChanged" />
                            <TextBox x:Name="TxtApiKeyVisible" Background="#141414" Foreground="#00E5FF" BorderBrush="#444444"
                                     FontSize="13" Padding="8,5" VerticalAlignment="Center" Visibility="Collapsed" TextChanged="OnVisibleKeyChanged" />

                            <Button x:Name="BtnToggleKeyVisible" Grid.Column="1" Content="👁" Style="{StaticResource ActionButton}"
                                    Margin="6,0,0,0" Click="OnToggleKeyVisibilityClick" ToolTip="Show/Hide API Key" />
                            <Button x:Name="BtnTestKey" Grid.Column="2" Content="Test Key" Style="{StaticResource ActionButton}"
                                    Margin="6,0,0,0" Click="OnTestKeyClick" ToolTip="Verify API Key with a quick ping" />
                        </Grid>

                        <TextBlock x:Name="TxtKeyStatus" Text="API Key not configured." FontSize="11" Foreground="#999999" />
                    </StackPanel>
                </Border>

                <!-- 3. System Instructions & Personal Reporting Style -->
                <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="3. Custom Reporting Style &amp; Reference Reports (System Instructions)"
                                   FontWeight="Bold" FontSize="13" Foreground="#00E5FF" Margin="0,0,0,4" />
                        <TextBlock Text="Paste your personal reporting template, formatting rules, or report samples from your history. Gemini will tailor its diagnostic wording to match your exact style."
                                   FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBox x:Name="TxtSystemInstructions" Background="#141414" Foreground="#E0E0E0" BorderBrush="#444444"
                                 FontSize="12" FontFamily="Consolas, Segoe UI" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="130" VerticalScrollBarVisibility="Auto" Padding="8" />

                        <DockPanel Margin="0,6,0,0">
                            <Button Content="Reset to Default Medical Prompt" Style="{StaticResource ActionButton}" Padding="8,3" FontSize="11"
                                    Click="OnResetPromptClick" />
                            <CheckBox x:Name="ChkMultiViewport" Content="Crop all visible viewport series simultaneously"
                                      IsChecked="True" Foreground="#CCCCCC" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" Padding="18,6" Click="OnSaveClick" />
                <Button Content="Cancel" Style="{StaticResource ActionButton}" Padding="16,6" DockPanel.Dock="Right" Click="OnCancelClick" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
