<Window x:Class="OpenRadViewer.Views.PacsConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PACS Configuration (DICOM Locations &amp; Settings)" 
        Height="620" Width="820"
        MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#181818" Foreground="#E0E0E0">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#222222" />
        <SolidColorBrush x:Key="AccentGold" Color="#F5AF28" />

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383838" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#666666" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#D9971E" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#F5AF28" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CaretBrush" Value="#F5AF28" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderBrush" Value="#2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#252525" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowBackground" Value="#181818" />
            <Setter Property="AlternatingRowBackground" Value="#1E1E1E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="BorderBrush" Value="#2E2E2E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#283A4A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="Selector.IsSelectionActive" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#283A4A" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </MultiTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202A36" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Local Settings -->
            <RowDefinition Height="*" />    <!-- Servers Table -->
            <RowDefinition Height="Auto" /> <!-- Add/Edit Form (Collapsible) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Local Listener Configuration -->
        <Border Grid.Row="0" Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Local DICOM Settings (C-STORE SCP Receiver)" FontWeight="Bold" FontSize="13" Foreground="#F5AF28" Margin="0,0,0,8" />
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="Listener port:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtListenerPort" Width="70" Text="46001" VerticalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="My AE title:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtLocalAeTitle" Width="150" Text="AE_REZIDENTI@@" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <!-- Listener Status & Start/Stop -->
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <Ellipse x:Name="ListenerLed" Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtListenerStatus" Text="Active on port 46001" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="BtnToggleListener" Content="Restart Receiver" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="11" Click="OnToggleListenerClicked" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="For receiving studies via C-MOVE, ensure the PACS server has registered this workstation's AE title and port configured above." 
                           Foreground="#888888" FontSize="11" Margin="0,6,0,0" FontStyle="Italic" />

                <!-- Cache Management & Auto-cleanup -->
                <Separator Grid.Row="2" Grid.ColumnSpan="2" Background="#2E2E2E" Margin="0,10,0,10" />

                <Grid Grid.Row="3" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Temporary PACS Cache &amp; Auto-Cleanup" FontWeight="Bold" FontSize="12" Foreground="#F5AF28" Margin="0,0,0,6" />
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                                <TextBlock Text="Disk usage:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="TxtCacheSize" Text="Calculating..." FontWeight="SemiBold" Foreground="#4CAF50" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <TextBlock Text="Auto-cleanup:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbCacheRetention" Width="240" VerticalAlignment="Center">
                                    <ComboBoxItem Content="On application exit (Clear cache when closing)" IsSelected="True" />
                                    <ComboBoxItem Content="After 1 day" />
                                    <ComboBoxItem Content="After 3 days" />
                                    <ComboBoxItem Content="After 7 days" />
                                    <ComboBoxItem Content="Never (Manual purge only)" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="BtnOpenCacheDir" Content="Open Folder" Style="{StaticResource DarkButton}" Margin="0,0,8,0" Padding="8,4" FontSize="11" Click="OnOpenCacheDirClicked" />
                        <Button x:Name="BtnClearCacheNow" Content="Clear Cache Now" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="11" Foreground="#FF6B6B" Click="OnClearCacheNowClicked" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. PACS Servers List (DataGrid) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Configured PACS Locations" FontWeight="SemiBold" FontSize="12.5" Foreground="#EEEEEE" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DarkButton}" Margin="4,0" Padding="8,4" Click="OnTestEchoSelectedClicked" ToolTip="Verify connection (C-ECHO Ping SCU) with selected PACS host">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✔" Foreground="#4CAF50" FontWeight="Bold" Margin="0,0,5,0" />
                            <TextBlock Text="Test C-ECHO" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DarkButton}" Margin="4,0" Padding="8,4" Click="OnTestEchoAllClicked" ToolTip="Verify connection with all configured PACS servers">
                        <TextBlock Text="Test All" />
                    </Button>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="GridServers" Grid.Row="1" ItemsSource="{Binding Servers}" SelectionChanged="OnServerSelectionChanged" MouseDoubleClick="OnGridServersDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="IP Address / Host" Binding="{Binding IpAddress}" Width="140" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="65" />
                    <DataGridTextColumn Header="AE Title" Binding="{Binding AeTitle}" Width="120" />
                    <DataGridTextColumn Header="Retrieve Mode" Binding="{Binding RetrievalMode}" Width="100" />
                    <DataGridTemplateColumn Header="Connection Status" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#AAAAAA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status, Converter={x:Null}}" Value="Online">
                                                        <Setter Property="Foreground" Value="#4CAF50" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 3. Add / Edit Inline Editor Panel -->
        <Border x:Name="EditPanel" Grid.Row="2" Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtEditTitle" Grid.Row="0" Text="Add PACS Location" FontWeight="Bold" FontSize="12.5" Foreground="#F5AF28" Margin="0,0,0,8" />

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="Description:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtEditDesc" Width="140" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="IP Address:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtEditIp" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="Port:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtEditPort" Width="60" Text="4020" TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="PACS AE Title:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtEditAe" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="Retrieve Mode:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbEditMode" Width="95">
                            <ComboBoxItem Content="C-MOVE" IsSelected="True" />
                            <ComboBoxItem Content="C-GET" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="Transfer Syntax:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbEditSyntax" Width="130">
                            <ComboBoxItem Content="Explicit VR Little Endian" IsSelected="True" />
                            <ComboBoxItem Content="Implicit VR Little Endian" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Style="{StaticResource DarkButton}" Content="Cancel" Margin="0,0,8,0" Click="OnCancelEditClicked" />
                    <Button Style="{StaticResource GoldButton}" Content="Save Location" Click="OnSaveServerEditClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Bottom Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource DarkButton}" Content="+ Add Server..." Margin="0,0,6,0" Click="OnAddServerClicked" />
                <Button x:Name="BtnEditServer" Style="{StaticResource DarkButton}" Content="Edit..." Margin="0,0,6,0" Click="OnEditServerClicked" IsEnabled="False" />
                <Button x:Name="BtnDeleteServer" Style="{StaticResource DarkButton}" Content="Delete" Margin="0,0,6,0" Click="OnDeleteServerClicked" IsEnabled="False" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DarkButton}" Content="Close" Padding="14,6" Margin="0,0,8,0" Click="OnCloseClicked" />
                <Button Style="{StaticResource GoldButton}" Content="Save Configuration" Padding="14,6" Click="OnSaveAllClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
