<Window x:Class="OpenRadViewer.Views.ReferenceGuideViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reference Guide"
        Height="780" Width="1100"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#141414" Foreground="#E0E0E0">

    <Window.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="BorderBrush" Value="#383838" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#363636" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & Controls -->
            <RowDefinition Height="*" />    <!-- Interactive Image Viewport -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Badge -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeCategory" Background="#00838F" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtCategoryBadge" Text="REFERENCE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                        <TextBlock x:Name="TxtTitle" Text="Guide Title" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                    <TextBlock x:Name="TxtDescription" Text="" FontSize="11" Foreground="#888888" Margin="0,2,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- Right: Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Zoom In (+)" Style="{StaticResource HeaderBtn}" Margin="0,0,5,0" Click="OnZoomInClick" ToolTip="Zoom In (or Mouse Wheel Up)" />
                    <Button Content="Zoom Out (-)" Style="{StaticResource HeaderBtn}" Margin="0,0,5,0" Click="OnZoomOutClick" ToolTip="Zoom Out (or Mouse Wheel Down)" />
                    <Button Content="Fit" Style="{StaticResource HeaderBtn}" Margin="0,0,5,0" Click="OnFitClick" ToolTip="Fit image to window size" />
                    <Button Content="100%" Style="{StaticResource HeaderBtn}" Margin="0,0,10,0" Click="OnActualSizeClick" ToolTip="Reset to 1:1 original size" />

                    <Button Content="Copy" Style="{StaticResource HeaderBtn}" Margin="0,0,10,0" Click="OnCopyImageClick" ToolTip="Copy image to clipboard" />

                    <Button x:Name="BtnDelete" Content="Delete" Style="{StaticResource HeaderBtn}" Margin="0,0,10,0" Click="OnDeleteClick"
                            Foreground="#EF5350" BorderBrush="#80EF5350" ToolTip="Delete this custom guide" Visibility="Collapsed" />

                    <Button Content="Close" Style="{StaticResource HeaderBtn}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. INTERACTIVE IMAGE VIEWPORT -->
        <Border Grid.Row="1" Background="#111111" ClipToBounds="True"
                MouseWheel="OnViewportMouseWheel"
                MouseLeftButtonDown="OnViewportMouseDown"
                MouseLeftButtonUp="OnViewportMouseUp"
                MouseMove="OnViewportMouseMove"
                Cursor="SizeAll">
            <Grid x:Name="ViewportGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="GuideImage" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImgScale" ScaleX="1.0" ScaleY="1.0" />
                            <TranslateTransform x:Name="ImgTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>

        <!-- 3. BOTTOM STATUS / HELP BAR -->
        <Border Grid.Row="2" Background="#181818" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Zoom: 100%" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="Tip: Use Mouse Wheel to Zoom • Click and drag to Pan" Foreground="#666666" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" FontStyle="Italic" />
            </Grid>
        </Border>
    </Grid>
</Window>
