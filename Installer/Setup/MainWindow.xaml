<Window x:Class="Parsec.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parsec Medical DICOM Viewer — Setup (v1.0 Beta)"
        Height="490" Width="640"
        MinHeight="490" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#E0E0E0">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#404040" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333333" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#666666" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#D9971E" />
            <Setter Property="Foreground" Value="#121212" />
            <Setter Property="BorderBrush" Value="#F5AF28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Form & Progress -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="48" Height="48" CornerRadius="8" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                <Path Stroke="#F5AF28" StrokeThickness="1.6" Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Parsec Medical DICOM Viewer" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                    <Border Background="#332200" BorderBrush="#F5AF28" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="v1.0 Beta" FontSize="10.5" FontWeight="Bold" Foreground="#F5AF28" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Installation &amp; Workstation Setup Package" FontSize="11.5" Foreground="#888888" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- 2. MAIN CONTENT -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Info Card -->
            <Border Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                <TextBlock Text="This setup wizard will install Parsec Medical DICOM Viewer on your computer, including multi-modality 3D MPR, Direct3D 11 volume rendering, spinal anatomy labeling, and PACS archive networking."
                           FontSize="11.5" Foreground="#B0B0B0" TextWrapping="Wrap" LineHeight="16" />
            </Border>

            <!-- Destination Folder Selection -->
            <TextBlock Text="Destination Folder:" FontSize="12" FontWeight="SemiBold" Foreground="#DDDDDD" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInstallPath" Grid.Column="0" FontSize="11.5" VerticalContentAlignment="Center" />
                <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource DarkButton}" Content="Browse..." Margin="8,0,0,0" Padding="12,5" Click="OnBrowseClicked" />
            </Grid>

            <!-- Options -->
            <TextBlock Text="Installation Options:" FontSize="12" FontWeight="SemiBold" Foreground="#DDDDDD" Margin="0,0,0,6" />
            <StackPanel Margin="2,0,0,10">
                <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop shortcut" IsChecked="True" />
                <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu shortcut" IsChecked="True" />
                <CheckBox x:Name="ChkFileAssociation" Content="Register .dcm DICOM file association (open with Parsec)" IsChecked="True" />
            </StackPanel>

            <!-- Progress & Status -->
            <StackPanel x:Name="PnlProgress" Visibility="Collapsed" Margin="0,6,0,0">
                <ProgressBar x:Name="PbInstall" Height="7" Maximum="100" Value="0" Background="#222222" Foreground="#F5AF28" BorderThickness="0" Margin="0,0,0,6" />
                <TextBlock x:Name="TxtStatus" Text="Extracting application files..." FontSize="11" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Post-Install Checkbox -->
            <StackPanel x:Name="PnlFinished" Visibility="Collapsed" Margin="0,8,0,0">
                <CheckBox x:Name="ChkLaunchAfter" Content="Launch Parsec Medical DICOM Viewer now" IsChecked="True" FontWeight="SemiBold" Foreground="#00E5FF" />
            </StackPanel>
        </StackPanel>

        <!-- 3. FOOTER BUTTONS -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <TextBlock x:Name="TxtResult" Text="" FontSize="11.5" Foreground="#00E676" VerticalAlignment="Center" />
            <Button x:Name="BtnCancel" DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Cancel" Width="90" Click="OnCancelClicked" IsCancel="True" />
            <Button x:Name="BtnInstall" DockPanel.Dock="Right" Style="{StaticResource GoldButton}" Content="Install" Width="105" Margin="0,0,10,0" Click="OnInstallClicked" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
